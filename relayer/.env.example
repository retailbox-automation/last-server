# Studio account that creates player sub-accounts and signs relayed transactions.
LASTSERVER_ACCOUNT_ID=
LASTSERVER_SECRET_KEY=
# World contract the relayer is allowed to call.
WORLD_CONTRACT_ID=
# Optional (defaults in brackets).
RPC_URL=
PORT=
HOST=
ALLOWED_ORIGIN=
# Number of reverse proxies in front of the relayer that append to X-Forwarded-For [0].
# Behind Zeabur or any other platform proxy set 1, or every player shares one rate-limit bucket.
# Leave 0 when clients connect directly (otherwise they can choose their IP by sending the header).
TRUST_PROXY_HOPS=
# testnet NEAR given to each new player [0.2]
SIGNUP_FUNDING_NEAR=
# Signup is refused (503 studio_funds_low) when it would leave the studio below this [1]
MIN_STUDIO_BALANCE_NEAR=
RATE_RELAY_SENDER_MAX=
RATE_RELAY_SENDER_WINDOW_S=
RATE_RELAY_IP_MAX=
RATE_RELAY_IP_WINDOW_S=
RATE_SIGNUP_IP_MAX=
RATE_SIGNUP_IP_WINDOW_S=
RATE_SIGNUP_GLOBAL_MAX=
RATE_SIGNUP_GLOBAL_WINDOW_S=
RATE_LOOKUP_IP_MAX=
RATE_LOOKUP_IP_WINDOW_S=
