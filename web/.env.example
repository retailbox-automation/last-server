# All optional. Defaults in brackets.
# NEAR JSON-RPC endpoint [https://test.rpc.fastnear.com]
VITE_RPC_URL=
# World contract [world.lastserver.testnet]
VITE_WORLD_CONTRACT_ID=
# Relayer base URL; empty = no relayer, players send transactions themselves [http://localhost:8787 in dev, empty in a build]
VITE_RELAYER_URL=
# Studio account the player accounts are created under [lastserver.testnet]
VITE_PARENT_ACCOUNT_ID=
